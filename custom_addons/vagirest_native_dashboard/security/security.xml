<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="group_personal_dashboard" model="res.groups">
    <field name="name">داشبورد شخصی واژیرست</field>
  </record>
  <record id="rule_dashboard_owner" model="ir.rule">
    <field name="name">VAGIREST: personal dashboard ownership</field>
    <field name="model_id" ref="spreadsheet_dashboard.model_spreadsheet_dashboard"/>
    <field name="domain_force">[(1, '=', 1)] if user.has_group('sales_team.group_sale_manager') else ['|', ('vagirest_dashboard_owner_id', '=', False), ('vagirest_dashboard_owner_id', '=', user.id)]</field>
  </record>
  <record id="rule_dashboard_company" model="ir.rule">
    <field name="name">VAGIREST: dashboard company</field>
    <field name="model_id" ref="spreadsheet_dashboard.model_spreadsheet_dashboard"/>
    <field name="domain_force">['|', ('vagirest_dashboard_company_id', '=', False), ('vagirest_dashboard_company_id', 'in', company_ids)]</field>
  </record>
</odoo>
