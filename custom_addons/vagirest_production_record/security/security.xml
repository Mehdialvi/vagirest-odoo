<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="module_category_vagirest_operations" model="ir.module.category">
        <field name="name">عملیات واژیرست</field>
        <field name="description">
            دسترسی‌های تولید، کنترل کیفیت و مدیریت ERP واژیرست
        </field>
        <field name="sequence">35</field>
    </record>

    <record id="group_vagirest_inventory_viewer" model="res.groups"><field name="name">مشاهده‌گر انبار واژیرست</field><field name="category_id" ref="module_category_vagirest_operations"/><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record><record id="group_vagirest_production_operator" model="res.groups">
        <field name="name">اپراتور تولید</field>
        <field name="category_id" ref="module_category_vagirest_operations"/>
        <field name="implied_ids" eval="[&#10;            (4, ref('base.group_user')),&#10;            (4, ref('group_vagirest_inventory_viewer'))&#10;        ]"/>
    </record>

    <record id="group_vagirest_qc_manager" model="res.groups">
        <field name="name">کنترل کیفیت و مسئول فنی</field>
        <field name="category_id" ref="module_category_vagirest_operations"/>
        <field name="implied_ids" eval="[&#10;            (4, ref('base.group_user')),&#10;            (4, ref('group_vagirest_inventory_viewer'))&#10;        ]"/>
    </record>

    <record id="group_vagirest_erp_manager" model="res.groups">
        <field name="name">مدیر ERP واژیرست</field>
        <field name="category_id" ref="module_category_vagirest_operations"/>
        <field name="implied_ids" eval="[                    (4, ref('group_vagirest_production_operator')),                    (4, ref('group_vagirest_qc_manager'))                ]"/>
    </record>

    <record id="rule_production_correction_request_operator"
            model="ir.rule">
        <field name="name">
            Production Correction Request - Own Requests
        </field>
        <field name="model_id"
               ref="model_vagirest_production_correction_request"/>
        <field name="groups"
               eval="[(4, ref('group_vagirest_production_operator'))]"/>
        <field name="domain_force">
            [('requester_id', '=', user.id)]
        </field>
    </record>

    <record id="rule_production_correction_request_qc"
            model="ir.rule">
        <field name="name">
            Production Correction Request - QC All
        </field>
        <field name="model_id"
               ref="model_vagirest_production_correction_request"/>
        <field name="groups"
               eval="[(4, ref('group_vagirest_qc_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>


    <record id="rule_qc_correction_request_requester"
            model="ir.rule">
        <field name="name">
            QC Correction Request - Own Requests
        </field>
        <field name="model_id"
               ref="model_vagirest_qc_correction_request"/>
        <field name="groups"
               eval="[(4, ref('group_vagirest_qc_manager'))]"/>
        <field name="domain_force">
            [('requester_id', '=', user.id)]
        </field>
    </record>

    <record id="rule_qc_correction_request_erp"
            model="ir.rule">
        <field name="name">
            QC Correction Request - ERP Manager All
        </field>
        <field name="model_id"
               ref="model_vagirest_qc_correction_request"/>
        <field name="groups"
               eval="[(4, ref('group_vagirest_erp_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
