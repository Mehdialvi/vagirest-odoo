class VagirestReworkQCRecordCompanyFix(models.Model):
    _inherit = "vagirest.rework.qc.record"

    company_id = fields.Many2one(
        related="rework_record_id.company_id",
        store=True,
        readonly=True,
    )

    def _create_qc_transfer(self, picking_type_id, dest_location_id, quantity, label):
        self.ensure_one()

        if quantity <= 0:
            return False

        company = self.company_id or self.env.company

        picking_type = self._get_qc_picking_type(
            picking_type_id,
            40,
            dest_location_id,
        )

        Picking = self.env[
            "stock.picking"
        ].sudo().with_company(company)

        Move = self.env[
            "stock.move"
        ].sudo().with_company(company)

        MoveLine = self.env[
            "stock.move.line"
        ].sudo().with_company(company)

        picking = Picking.create({
            "picking_type_id": picking_type.id,
            "location_id": 40,
            "location_dest_id": dest_location_id,
            "origin": "%s / %s" % (
                self.name,
                self.rework_record_id.name,
            ),
            "company_id": company.id,
        })

        move = Move.create({
            "name": "%s - %s" % (
                label,
                self.product_id.display_name,
            ),
            "origin": self.name,
            "product_id": self.product_id.id,
            "product_uom_qty": quantity,
            "product_uom": self.product_id.uom_id.id,
            "location_id": 40,
            "location_dest_id": dest_location_id,
            "picking_id": picking.id,
            "company_id": company.id,
        })

        picking.action_confirm()

        MoveLine.create({
            "move_id": move.id,
            "picking_id": picking.id,
            "company_id": company.id,
            "product_id": self.product_id.id,
            "product_uom_id": self.product_id.uom_id.id,
            "quantity": quantity,
            "picked": True,
            "lot_id": self.lot_id.id,
            "location_id": 40,
            "location_dest_id": dest_location_id,
        })

        validation_result = picking.with_context(
            cancel_backorder=True
        ).button_validate()

        if picking.state != "done":
            if isinstance(validation_result, dict):
                raise UserError(
                    _("The %s transfer requires an unexpected wizard.") % label
                )
            raise UserError(
                _("The %s transfer was not completed.") % label
            )

        return picking

    def _validate_decision(self):
        self.ensure_one()

        if self.state != "draft":
            raise UserError(
                _("Only draft Rework QC records can be submitted.")
            )

        if not self.product_id or not self.lot_id:
            raise UserError(_("Product and Lot are required."))

        quantities = [
            self.approved_qty,
            self.rework_qty,
            self.rejected_qty,
        ]

        if any(qty < 0 for qty in quantities):
            raise UserError(_("QC quantities cannot be negative."))

        total_decided = (
            self.approved_qty
            + self.rework_qty
            + self.rejected_qty
        )

        rounding = self.product_id.uom_id.rounding or 0.01

        if float_compare(
            total_decided,
            self.quantity,
            precision_rounding=rounding,
        ) != 0:
            raise UserError(
                _(
                    "Approved + Rework + Rejected must equal "
                    "the returned quantity.\n"
                    "Returned: %s\nDecided: %s"
                )
                % (self.quantity, total_decided)
            )

        Quant = self.env["stock.quant"].sudo()

        domain = [
            ("location_id", "=", 40),
            ("product_id", "=", self.product_id.id),
            ("lot_id", "=", self.lot_id.id),
        ]

        if self.company_id:
            domain.append(("company_id", "=", self.company_id.id))

        quants = Quant.search(domain)

        available = sum(quants.mapped("quantity")) - sum(
            quants.mapped("reserved_quantity")
        )

        if float_compare(
            available,
            self.quantity,
            precision_rounding=rounding,
        ) < 0:
            raise UserError(
                _(
                    "There is not enough available stock in input-QC "
                    "for this Lot.\n"
                    "Available: %s\nRequired: %s"
                )
                % (available, self.quantity)
            )
