from collections import defaultdict

from odoo import api, fields, models, _
from odoo.exceptions import UserError
from odoo.tools.float_utils import float_compare


# =========================================================
# Shared helpers
# =========================================================

def _available_quantity(env, product, location, lot):
    quants = (
        env["stock.quant"]
        .sudo()
        .with_company(env.company)
        .search([
            ("company_id", "=", env.company.id),
            ("location_id", "=", location.id),
            ("product_id", "=", product.id),
            ("lot_id", "=", lot.id if lot else False),
        ])
    )

    return (
        sum(quants.mapped("quantity"))
        - sum(quants.mapped("reserved_quantity"))
    )


def _reverse_done_picking(record, picking, label):
    """
    Reverse a completed picking through a real stock transfer.

    No stock.quant is modified directly.
    All required destination stock is verified before creating
    the reversal.
    """

    if not picking:
        return False

    if picking.state != "done":
        raise UserError(
            _(
                "Stock transfer %s is not Done and cannot "
                "be reversed automatically."
            )
            % picking.display_name
        )

    move_lines = picking.move_line_ids.filtered(
        lambda line: line.quantity > 0
    )

    if not move_lines:
        raise UserError(
            _("No completed quantities were found in %s.")
            % picking.display_name
        )

    requirements = defaultdict(float)
    samples = {}

    for line in move_lines:
        key = (
            line.product_id.id,
            line.location_dest_id.id,
            line.lot_id.id if line.lot_id else False,
            line.product_uom_id.id,
        )

        requirements[key] += line.quantity
        samples[key] = line

    # Verify everything before creating a reversal.
    for key, required_qty in requirements.items():
        line = samples[key]

        available_qty = _available_quantity(
            record.env,
            line.product_id,
            line.location_dest_id,
            line.lot_id,
        )

        rounding = line.product_uom_id.rounding or 0.01

        if float_compare(
            available_qty,
            required_qty,
            precision_rounding=rounding,
        ) < 0:
            raise UserError(
                _(
                    "Automatic correction is not safe.\n\n"
                    "Product: %s\n"
                    "Lot: %s\n"
                    "Location: %s\n"
                    "Required for reversal: %s\n"
                    "Available: %s\n\n"
                    "Use Legacy Record Correction instead."
                )
                % (
                    line.product_id.display_name,
                    line.lot_id.name if line.lot_id else "-",
                    line.location_dest_id.display_name,
                    required_qty,
                    available_qty,
                )
            )

    Picking = (
        record.env["stock.picking"]
        .sudo()
        .with_company(record.env.company)
    )

    Move = (
        record.env["stock.move"]
        .sudo()
        .with_company(record.env.company)
    )

    MoveLine = (
        record.env["stock.move.line"]
        .sudo()
        .with_company(record.env.company)
    )

    reverse_picking = Picking.create({
        "picking_type_id": picking.picking_type_id.id,
        "location_id": picking.location_dest_id.id,
        "location_dest_id": picking.location_id.id,
        "origin": "REV/%s/%s" % (
            record.display_name,
            picking.name,
        ),
        "company_id": record.env.company.id,
    })

    created_moves = []

    for key, quantity in requirements.items():
        line = samples[key]

        move = Move.create({
            "name": "%s - %s" % (
                label,
                line.product_id.display_name,
            ),
            "origin": reverse_picking.origin,
            "product_id": line.product_id.id,
            "product_uom_qty": quantity,
            "product_uom": line.product_uom_id.id,
            "location_id": line.location_dest_id.id,
            "location_dest_id": line.location_id.id,
            "picking_id": reverse_picking.id,
            "company_id": record.env.company.id,
        })

        created_moves.append(
            (move, line, quantity)
        )

    reverse_picking.action_confirm()

    for move, original_line, quantity in created_moves:
        MoveLine.create({
            "move_id": move.id,
            "picking_id": reverse_picking.id,
            "company_id": record.env.company.id,
            "product_id": original_line.product_id.id,
            "product_uom_id": original_line.product_uom_id.id,
            "quantity": quantity,
            "picked": True,
            "lot_id": (
                original_line.lot_id.id
                if original_line.lot_id
                else False
            ),
            "location_id": original_line.location_dest_id.id,
            "location_dest_id": original_line.location_id.id,
        })

    result = reverse_picking.with_context(
        cancel_backorder=True
    ).button_validate()

    if reverse_picking.state != "done":
        if isinstance(result, dict):
            raise UserError(
                _(
                    "The reversal of %s requires an unexpected "
                    "validation wizard."
                )
                % picking.display_name
            )

        raise UserError(
            _("The reversal transfer was not completed.")
        )

    return reverse_picking


