class VagirestQCRecordCorrection(models.Model):
    _inherit = "vagirest.qc.record"

    state = fields.Selection(
        selection_add=[
            ("cancelled", "Cancelled"),
        ],
        ondelete={
            "cancelled": "set default",
        },
    )

    correction_reason = fields.Text(
        string="Correction / Cancellation Reason",
        copy=False,
    )

    last_corrected_by_id = fields.Many2one(
        "res.users",
        string="Last Corrected By",
        readonly=True,
        copy=False,
    )

    last_correction_date = fields.Datetime(
        string="Last Correction Date",
        readonly=True,
        copy=False,
    )

    last_correction_reason = fields.Text(
        string="Last Correction Reason",
        readonly=True,
        copy=False,
    )

    correction_count = fields.Integer(
        string="Correction Count",
        default=0,
        readonly=True,
        copy=False,
    )

    approved_reversal_picking_id = fields.Many2one(
        "stock.picking",
        string="Approved Reversal",
        readonly=True,
        copy=False,
    )

    rework_reversal_picking_id = fields.Many2one(
        "stock.picking",
        string="Rework Reversal",
        readonly=True,
        copy=False,
    )

    rejected_reversal_picking_id = fields.Many2one(
        "stock.picking",
        string="Rejected Reversal",
        readonly=True,
        copy=False,
    )

    legacy_correction_ids = fields.One2many(
        "vagirest.qc.legacy.correction",
        "qc_record_id",
        string="Legacy Corrections",
    )

    def _check_qc_access(self):
        if not self.env.user.has_group(
            "vagirest_production_record."
            "group_vagirest_erp_manager"
        ):
            raise UserError(
                _(
                    "Only the VAGIREST ERP Manager may execute "
                    "a direct QC correction."
                )
            )

    def _require_qc_reason(self):
        self.ensure_one()

        if not (self.correction_reason or "").strip():
            raise UserError(
                _("Enter the QC correction reason first.")
            )

    def _has_rework_history(self):
        self.ensure_one()

        if not self.line_ids:
            return False

        return bool(
            self.env["vagirest.rework.record"]
            .sudo()
            .search_count([
                ("source_qc_line_id", "in", self.line_ids.ids),
            ])
        )

    def _reverse_qc_transfers(self):
        self.ensure_one()

        if self._has_rework_history():
            raise UserError(
                _(
                    "This QC record has Rework history and cannot "
                    "be reversed automatically.\n\n"
                    "Use Legacy QC Correction."
                )
            )

        approved_reverse = (
            _reverse_done_picking(
                self,
                self.approved_picking_id,
                "QC Approved Reversal",
            )
            if self.approved_picking_id
            else False
        )

        rework_reverse = (
            _reverse_done_picking(
                self,
                self.rework_picking_id,
                "QC Rework Reversal",
            )
            if self.rework_picking_id
            else False
        )

        rejected_reverse = (
            _reverse_done_picking(
                self,
                self.rejected_picking_id,
                "QC Rejected Reversal",
            )
            if self.rejected_picking_id
            else False
        )

        return (
            approved_reverse,
            rework_reverse,
            rejected_reverse,
        )

    def action_reopen_decision(self):
        self._check_qc_access()

        for record in self:
            if record.state != "done":
                raise UserError(
                    _("Only Done QC can be reopened.")
                )

            record._require_qc_reason()

            reason = record.correction_reason.strip()

            (
                approved_reverse,
                rework_reverse,
                rejected_reverse,
            ) = record._reverse_qc_transfers()

            record.with_context(
                allow_qc_correction=True
            ).write({
                "state": "draft",
                "inspector_id": False,
                "decision_date": False,
                "approved_picking_id": False,
                "rework_picking_id": False,
                "rejected_picking_id": False,
                "approved_reversal_picking_id": (
                    approved_reverse.id
                    if approved_reverse else False
                ),
                "rework_reversal_picking_id": (
                    rework_reverse.id
                    if rework_reverse else False
                ),
                "rejected_reversal_picking_id": (
                    rejected_reverse.id
                    if rejected_reverse else False
                ),
                "last_corrected_by_id": self.env.user.id,
                "last_correction_date": fields.Datetime.now(),
                "last_correction_reason": reason,
                "correction_count": record.correction_count + 1,
                "correction_reason": False,
            })

        return True

    def action_cancel_decision(self):
        self._check_qc_access()

        for record in self:
            if record.state != "done":
                raise UserError(
                    _("Only Done QC can be cancelled.")
                )

            record._require_qc_reason()

            reason = record.correction_reason.strip()

            (
                approved_reverse,
                rework_reverse,
                rejected_reverse,
            ) = record._reverse_qc_transfers()

            record.with_context(
                allow_qc_correction=True
            ).write({
                "state": "cancelled",
                "approved_picking_id": False,
                "rework_picking_id": False,
                "rejected_picking_id": False,
                "approved_reversal_picking_id": (
                    approved_reverse.id
                    if approved_reverse else False
                ),
                "rework_reversal_picking_id": (
                    rework_reverse.id
                    if rework_reverse else False
                ),
                "rejected_reversal_picking_id": (
                    rejected_reverse.id
                    if rejected_reverse else False
                ),
                "last_corrected_by_id": self.env.user.id,
                "last_correction_date": fields.Datetime.now(),
                "last_correction_reason": reason,
                "correction_count": record.correction_count + 1,
                "correction_reason": False,
            })

        return True

    def action_open_legacy_qc_correction(self):
        self.ensure_one()
        self._check_qc_access()

        Correction = self.env[
            "vagirest.qc.legacy.correction"
        ]

        correction = Correction.search([
            ("qc_record_id", "=", self.id),
            ("state", "=", "draft"),
        ], limit=1)

        if not correction:
            correction = Correction.create({
                "qc_record_id": self.id,
                "corrected_note": self.note,
            })

            Line = self.env[
                "vagirest.qc.legacy.correction.line"
            ]

            for line in self.line_ids:
                Line.create({
                    "correction_id": correction.id,
                    "original_line_id": line.id,
                    "product_id": line.product_id.id,
                    "lot_id": line.lot_id.id,
                    "produced_qty": line.produced_qty,
                    "approved_qty": line.approved_qty,
                    "rework_qty": line.rework_qty,
                    "rejected_qty": line.rejected_qty,
                })

        return {
            "type": "ir.actions.act_window",
            "name": _("Legacy QC Correction"),
            "res_model": "vagirest.qc.legacy.correction",
            "res_id": correction.id,
            "view_mode": "form",
            "target": "current",
        }


# =========================================================
# QC legacy correction
# =========================================================

class VagirestQCLegacyCorrection(models.Model):
    _name = "vagirest.qc.legacy.correction"
    _description = "VAGIREST QC Legacy Correction"
    _inherit = ["mail.thread", "mail.activity.mixin"]
    _order = "id desc"

    name = fields.Char(
        default="New",
        readonly=True,
        copy=False,
    )

    qc_record_id = fields.Many2one(
        "vagirest.qc.record",
        required=True,
        readonly=True,
        ondelete="restrict",
    )

    reason = fields.Text(
        required=True,
        tracking=True,
    )

    corrected_note = fields.Text(
        string="Corrected QC Notes",
    )

    line_ids = fields.One2many(
        "vagirest.qc.legacy.correction.line",
        "correction_id",
        string="Corrected QC Lines",
    )

    state = fields.Selection(
        [
            ("draft", "Draft"),
            ("confirmed", "Confirmed"),
            ("cancelled", "Cancelled"),
        ],
        default="draft",
        required=True,
        readonly=True,
        tracking=True,
    )

    confirmed_by_id = fields.Many2one(
        "res.users",
        readonly=True,
    )

    confirmed_date = fields.Datetime(
        readonly=True,
    )

    @api.model_create_multi
    def create(self, vals_list):
        sequence = self.env["ir.sequence"]

        for vals in vals_list:
            if vals.get("name", "New") == "New":
                vals["name"] = (
                    sequence.next_by_code(
                        "vagirest.qc.legacy.correction"
                    )
                    or "New"
                )

        return super().create(vals_list)

    def action_confirm(self):
        if not self.env.user.has_group(
            "vagirest_production_record."
            "group_vagirest_erp_manager"
        ):
            raise UserError(
                _(
                    "Only the VAGIREST ERP Manager may confirm "
                    "a legacy QC correction."
                )
            )

        for record in self:
            if record.state != "draft":
                raise UserError(
                    _("Only Draft corrections can be confirmed.")
                )

            if not (record.reason or "").strip():
                raise UserError(
                    _("Correction reason is required.")
                )

            if not record.line_ids:
                raise UserError(
                    _("No QC correction lines were found.")
                )

            for line in record.line_ids:
                quantities = [
                    line.approved_qty,
                    line.rework_qty,
                    line.rejected_qty,
                ]

                if any(qty < 0 for qty in quantities):
                    raise UserError(
                        _("QC quantities cannot be negative.")
                    )

                total = sum(quantities)

                rounding = (
                    line.product_id.uom_id.rounding
                    or 0.01
                )

                if float_compare(
                    total,
                    line.produced_qty,
                    precision_rounding=rounding,
                ) != 0:
                    raise UserError(
                        _(
                            "For %s, Approved + Rework + Rejected "
                            "must equal Produced (%s)."
                        )
                        % (
                            line.product_id.display_name,
                            line.produced_qty,
                        )
                    )

            record.write({
                "state": "confirmed",
                "confirmed_by_id": self.env.user.id,
                "confirmed_date": fields.Datetime.now(),
            })

        return True

    def action_cancel(self):
        if not self.env.user.has_group(
            "vagirest_production_record."
            "group_vagirest_erp_manager"
        ):
            raise UserError(
                _(
                    "Only the VAGIREST ERP Manager may cancel "
                    "a legacy QC correction."
                )
            )

        for record in self:
            if record.state != "draft":
                raise UserError(
                    _("Only Draft corrections can be cancelled.")
                )

            record.write({
                "state": "cancelled",
            })

        return True


class VagirestQCLegacyCorrectionLine(models.Model):
    _name = "vagirest.qc.legacy.correction.line"
    _description = "QC Legacy Correction Line"

    correction_id = fields.Many2one(
        "vagirest.qc.legacy.correction",
        required=True,
        ondelete="cascade",
    )

    original_line_id = fields.Many2one(
        "vagirest.qc.record.line",
        readonly=True,
        ondelete="set null",
    )

    product_id = fields.Many2one(
        "product.product",
        required=True,
        readonly=True,
    )

    lot_id = fields.Many2one(
        "stock.lot",
        readonly=True,
    )

    produced_qty = fields.Float(
        readonly=True,
    )

    approved_qty = fields.Float()

    rework_qty = fields.Float()

    rejected_qty = fields.Float()
