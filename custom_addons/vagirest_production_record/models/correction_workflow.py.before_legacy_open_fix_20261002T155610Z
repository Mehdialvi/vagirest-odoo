class VagirestProductionRecordCorrection(models.Model):
    _inherit = "vagirest.production.record"

    state = fields.Selection(
        selection_add=[
            ("cancelled", "Cancelled"),
        ],
        ondelete={
            "cancelled": "set default",
        },
    )

    correction_reason = fields.Text(
        string="Correction / Cancellation Reason",
        tracking=True,
        copy=False,
    )

    last_corrected_by_id = fields.Many2one(
        "res.users",
        string="Last Corrected By",
        readonly=True,
        copy=False,
        tracking=True,
    )

    last_correction_date = fields.Datetime(
        string="Last Correction Date",
        readonly=True,
        copy=False,
        tracking=True,
    )

    correction_count = fields.Integer(
        string="Correction Count",
        default=0,
        readonly=True,
        copy=False,
    )

    reversal_picking_id = fields.Many2one(
        "stock.picking",
        string="Last Reversal Transfer",
        readonly=True,
        copy=False,
        tracking=True,
    )

    legacy_correction_ids = fields.One2many(
        "vagirest.production.legacy.correction",
        "production_record_id",
        string="Legacy Corrections",
    )

    def _check_correction_access(self):
        if not self.env.user.has_group(
            "vagirest_production_record."
            "group_vagirest_erp_manager"
        ):
            raise UserError(
                _(
                    "Only the VAGIREST ERP Manager may execute "
                    "a direct production correction."
                )
            )

    def _require_reason(self):
        self.ensure_one()

        if not (self.correction_reason or "").strip():
            raise UserError(
                _(
                    "Enter the correction / cancellation reason "
                    "before continuing."
                )
            )

    def _get_related_qc(self):
        self.ensure_one()

        return (
            self.env["vagirest.qc.record"]
            .sudo()
            .with_context(active_test=False)
            .search([
                ("production_record_id", "=", self.id),
            ], limit=1)
        )

    def action_submit_to_qc(self):
        result = super().action_submit_to_qc()

        for record in self:
            qc_record = record._get_related_qc()

            if qc_record:
                if not qc_record.active:
                    qc_record.sudo().write({
                        "active": True,
                    })

                qc_record._sync_lines_from_production()

        return result

    def action_return_to_draft(self):
        self._check_correction_access()

        for record in self:
            if record.state != "submitted":
                raise UserError(
                    _(
                        "Only a Submitted production record "
                        "can be returned to Draft."
                    )
                )

            record._require_reason()

            qc_record = record._get_related_qc()

            if qc_record and qc_record.state == "done":
                raise UserError(
                    _(
                        "The related QC decision is already Done.\n\n"
                        "Correct or cancel the QC decision first."
                    )
                )

            reason = record.correction_reason.strip()

            reversal = False

            # Early historical records sometimes have no picking.
            if record.stock_picking_id:
                reversal = _reverse_done_picking(
                    record,
                    record.stock_picking_id,
                    "Production Correction Reversal",
                )

            if qc_record and qc_record.state == "draft":
                qc_record.line_ids.sudo().unlink()

            record.line_ids.write({
                "lot_id": False,
                "stock_move_id": False,
            })

            record.write({
                "state": "draft",
                "stock_picking_id": False,
                "reversal_picking_id": (
                    reversal.id if reversal else False
                ),
                "last_corrected_by_id": self.env.user.id,
                "last_correction_date": fields.Datetime.now(),
                "correction_count": record.correction_count + 1,
                "correction_reason": False,
            })

            record.message_post(
                body=_(
                    "<b>Production returned to Draft for correction.</b>"
                    "<br/>Reason: %s"
                    "<br/>Reversal: %s"
                )
                % (
                    reason,
                    reversal.display_name
                    if reversal
                    else "Not required",
                )
            )

        return True

    def action_cancel_record(self):
        self._check_correction_access()

        for record in self:
            if record.state == "cancelled":
                raise UserError(
                    _("This production record is already cancelled.")
                )

            record._require_reason()

            qc_record = record._get_related_qc()

            if qc_record and qc_record.state == "done":
                raise UserError(
                    _(
                        "The related QC decision is Done. "
                        "Correct or cancel QC first."
                    )
                )

            reason = record.correction_reason.strip()
            reversal = False

            if (
                record.state == "submitted"
                and record.stock_picking_id
            ):
                reversal = _reverse_done_picking(
                    record,
                    record.stock_picking_id,
                    "Production Cancellation Reversal",
                )

            if qc_record and qc_record.state == "draft":
                qc_record.sudo().write({
                    "active": False,
                })

            record.write({
                "state": "cancelled",
                "reversal_picking_id": (
                    reversal.id if reversal else False
                ),
                "last_corrected_by_id": self.env.user.id,
                "last_correction_date": fields.Datetime.now(),
                "correction_count": record.correction_count + 1,
                "correction_reason": False,
            })

            record.message_post(
                body=_(
                    "<b>Production record cancelled.</b>"
                    "<br/>Reason: %s"
                    "<br/>Reversal: %s"
                )
                % (
                    reason,
                    reversal.display_name
                    if reversal
                    else "Not required",
                )
            )

        return True

    def action_duplicate_record(self):
        self.ensure_one()

        new_record = self.copy(default={
            "operator_id": self.env.user.id,
            "state": "draft",
            "stock_picking_id": False,
            "reversal_picking_id": False,
            "correction_reason": False,
            "last_corrected_by_id": False,
            "last_correction_date": False,
            "correction_count": 0,
        })

        return {
            "type": "ir.actions.act_window",
            "name": _("Production Record"),
            "res_model": "vagirest.production.record",
            "res_id": new_record.id,
            "view_mode": "form",
            "target": "current",
        }

    def action_open_legacy_correction(self):
        self.ensure_one()
        self._check_correction_access()

        Correction = self.env[
            "vagirest.production.legacy.correction"
        ]

        correction = Correction.search([
            ("production_record_id", "=", self.id),
            ("state", "=", "draft"),
        ], limit=1)

        if not correction:
            correction = Correction.create({
                "production_record_id": self.id,
                "corrected_production_date": self.production_date,
                "corrected_raw_material_batch": (
                    self.raw_material_batch
                ),
                "corrected_note": self.note,
            })

            Line = self.env[
                "vagirest.production.legacy.correction.line"
            ]

            for line in self.line_ids:
                Line.create({
                    "correction_id": correction.id,
                    "original_line_id": line.id,
                    "product_id": line.product_id.id,
                    "quantity": line.quantity,
                })

        return {
            "type": "ir.actions.act_window",
            "name": _("Legacy Production Correction"),
            "res_model": (
                "vagirest.production.legacy.correction"
            ),
            "res_id": correction.id,
            "view_mode": "form",
            "target": "current",
        }


# =========================================================
# Production legacy correction
# =========================================================

class VagirestProductionLegacyCorrection(models.Model):
    _name = "vagirest.production.legacy.correction"
    _description = "VAGIREST Production Legacy Correction"
    _inherit = ["mail.thread", "mail.activity.mixin"]
    _order = "id desc"

    name = fields.Char(
        default="New",
        readonly=True,
        copy=False,
    )

    production_record_id = fields.Many2one(
        "vagirest.production.record",
        required=True,
        readonly=True,
        ondelete="restrict",
    )

    reason = fields.Text(
        required=True,
        tracking=True,
    )

    corrected_production_date = fields.Date(
        string="Corrected Production Date",
        required=True,
    )

    corrected_raw_material_batch = fields.Char(
        string="Corrected Raw Material Batch",
        required=True,
    )

    corrected_note = fields.Text(
        string="Corrected Notes",
    )

    line_ids = fields.One2many(
        "vagirest.production.legacy.correction.line",
        "correction_id",
        string="Corrected Lines",
    )

    state = fields.Selection(
        [
            ("draft", "Draft"),
            ("confirmed", "Confirmed"),
            ("cancelled", "Cancelled"),
        ],
        default="draft",
        readonly=True,
        required=True,
        tracking=True,
    )

    confirmed_by_id = fields.Many2one(
        "res.users",
        readonly=True,
    )

    confirmed_date = fields.Datetime(
        readonly=True,
    )

    @api.model_create_multi
    def create(self, vals_list):
        sequence = self.env["ir.sequence"]

        for vals in vals_list:
            if vals.get("name", "New") == "New":
                vals["name"] = (
                    sequence.next_by_code(
                        "vagirest.production.legacy.correction"
                    )
                    or "New"
                )

        return super().create(vals_list)

    def action_confirm(self):
        if not self.env.user.has_group(
            "vagirest_production_record."
            "group_vagirest_erp_manager"
        ):
            raise UserError(
                _(
                    "Only the VAGIREST ERP Manager may confirm "
                    "a legacy production correction."
                )
            )

        for record in self:
            if record.state != "draft":
                raise UserError(
                    _("Only Draft corrections can be confirmed.")
                )

            if not (record.reason or "").strip():
                raise UserError(
                    _("Correction reason is required.")
                )

            if not record.line_ids:
                raise UserError(
                    _("At least one corrected line is required.")
                )

            if any(
                line.quantity <= 0
                for line in record.line_ids
            ):
                raise UserError(
                    _("Corrected quantities must be greater than zero.")
                )

            record.write({
                "state": "confirmed",
                "confirmed_by_id": self.env.user.id,
                "confirmed_date": fields.Datetime.now(),
            })

            record.production_record_id.message_post(
                body=_(
                    "<b>Legacy production correction confirmed.</b>"
                    "<br/>Correction: %s"
                    "<br/>Reason: %s"
                    "<br/><b>No stock quantity was changed.</b>"
                )
                % (
                    record.display_name,
                    record.reason,
                )
            )

        return True

    def action_cancel(self):
        if not self.env.user.has_group(
            "vagirest_production_record."
            "group_vagirest_erp_manager"
        ):
            raise UserError(
                _(
                    "Only the VAGIREST ERP Manager may cancel "
                    "a legacy production correction."
                )
            )

        for record in self:
            if record.state != "draft":
                raise UserError(
                    _("Only Draft corrections can be cancelled.")
                )

            record.write({
                "state": "cancelled",
            })

        return True


class VagirestProductionLegacyCorrectionLine(models.Model):
    _name = "vagirest.production.legacy.correction.line"
