from odoo import api, fields, models, _
from odoo.exceptions import UserError


class VagirestProductionRecord(models.Model):
    _name = "vagirest.production.record"
    _description = "VAGIREST Production Record"
    _inherit = ["mail.thread", "mail.activity.mixin"]
    _order = "production_date desc, id desc"

    name = fields.Char(
        string="Record Number",
        default="New",
        readonly=True,
        copy=False,
        tracking=True,
    )

    production_date = fields.Date(
        string="Production Date",
        default=fields.Date.context_today,
        required=True,
        tracking=True,
    )

    raw_material_batch = fields.Char(
        string="Raw Material Batch",
        required=True,
        tracking=True,
    )

    operator_id = fields.Many2one(
        "res.users",
        string="Operator",
        default=lambda self: self.env.user,
        required=True,
        readonly=True,
        tracking=True,
    )

    note = fields.Text(
        string="Notes",
        tracking=True,
    )

    line_ids = fields.One2many(
        "vagirest.production.record.line",
        "record_id",
        string="Produced Products",
        copy=True,
    )

    stock_picking_id = fields.Many2one(
        "stock.picking",
        string="Production Stock Transfer",
        readonly=True,
        copy=False,
        tracking=True,
    )

    state = fields.Selection(
        [
            ("draft", "Draft"),
            ("submitted", "Submitted to QC"),
        ],
        default="draft",
        required=True,
        readonly=True,
        copy=False,
        tracking=True,
    )

    @api.model_create_multi
    def create(self, vals_list):
        sequence = self.env["ir.sequence"].with_company(
            self.env.company
        )

        for vals in vals_list:
            if vals.get("name", "New") == "New":
                vals["name"] = sequence.next_by_code(
                    "vagirest.production.record"
                ) or "New"

            vals.setdefault("operator_id", self.env.user.id)

        return super().create(vals_list)

    def _get_production_picking_type(self):
        picking_type = self.env[
            "stock.picking.type"
        ].sudo().with_company(
            self.env.company
        ).with_context(active_test=False).search([
            ("id", "=", 50),
            ("company_id", "=", self.env.company.id),
        ], limit=1)

        if not picking_type:
            raise UserError(
                _(
                    "The Production Record to Input QC "
                    "operation type was not found."
                )
            )

        if not picking_type.active:
            raise UserError(
                _(
                    "The Production Record to Input QC "
                    "operation type is archived."
                )
            )

        source_location = (
            picking_type.default_location_src_id
        )
        destination_location = (
            picking_type.default_location_dest_id
        )

        if (
            not source_location
            or source_location.usage != "production"
        ):
            raise UserError(
                _(
                    "The production operation does not have "
                    "a valid virtual production source."
                )
            )

        if (
            not destination_location
            or destination_location.usage != "internal"
            or destination_location.id != 40
        ):
            raise UserError(
                _(
                    "The production operation does not have "
                    "input-QC as its destination."
                )
            )

        return picking_type

    def _get_or_create_lot(self, line):
        lot_model = self.env[
            "stock.lot"
        ].sudo().with_company(self.env.company)

        lot = lot_model.search([
            ("name", "=", line.generated_lot),
            ("product_id", "=", line.product_id.id),
            ("company_id", "=", self.env.company.id),
        ], limit=1)

        if not lot:
            lot = lot_model.create({
                "name": line.generated_lot,
                "product_id": line.product_id.id,
                "company_id": self.env.company.id,
            })

        return lot

    def _validate_production_lines(self):
        self.ensure_one()

        if not self.line_ids:
            raise UserError(
                _("Please enter at least one produced product.")
            )

        invalid_lines = self.line_ids.filtered(
            lambda line: line.quantity <= 0
        )

        if invalid_lines:
            raise UserError(
                _(
                    "Every production line must have a "
                    "quantity greater than zero."
                )
            )

        duplicate_products = []

        for product in self.line_ids.mapped("product_id"):
            product_lines = self.line_ids.filtered(
                lambda line: line.product_id == product
            )

            if len(product_lines) > 1:
                duplicate_products.append(
                    product.display_name
                )

        if duplicate_products:
            raise UserError(
                _(
                    "Each product may appear only once in "
                    "a production record.\n\n"
                    "Duplicate products:\n- %s"
                )
                % "\n- ".join(duplicate_products)
            )

        for line in self.line_ids:
            product = line.product_id

            if product.type != "product":
                raise UserError(
                    _("Product %s is not a storable product.")
                    % product.display_name
                )

            if product.tracking != "lot":
                raise UserError(
                    _("Product %s must use tracking by lots.")
                    % product.display_name
                )

            if (
                product.company_id
                and product.company_id != self.env.company
            ):
                raise UserError(
                    _("Product %s belongs to another company.")
                    % product.display_name
                )

            if not line.generated_lot:
                raise UserError(
                    _(
                        "A lot number could not be generated "
                        "for product %s."
                    )
                    % product.display_name
                )

    def action_submit_to_qc(self):
        if not self.env.user.has_group(
            "vagirest_production_record."
            "group_vagirest_production_operator"
        ):
            raise UserError(
                _(
                    "You do not have permission "
                    "to submit production records."
                )
            )

        for record in self:
            if record.state != "draft":
                raise UserError(
                    _("Only draft records can be submitted.")
                )

            if record.stock_picking_id:
                raise UserError(
                    _(
                        "A stock transfer has already been "
                        "created for this production record."
                    )
                )

            record._validate_production_lines()

            if record.name == "New":
                record.name = self.env[
                    "ir.sequence"
                ].with_company(
                    self.env.company
                ).next_by_code(
                    "vagirest.production.record"
                ) or "New"

            picking_type = (
                record._get_production_picking_type()
            )

            source_location = (
                picking_type.default_location_src_id
            )
            destination_location = (
                picking_type.default_location_dest_id
            )

            stock_picking_model = self.env[
                "stock.picking"
            ].sudo().with_company(self.env.company)

            stock_move_model = self.env[
                "stock.move"
            ].sudo().with_company(self.env.company)

            stock_move_line_model = self.env[
                "stock.move.line"
            ].sudo().with_company(self.env.company)

            picking = stock_picking_model.create({
                "picking_type_id": picking_type.id,
                "location_id": source_location.id,
                "location_dest_id": destination_location.id,
                "origin": record.name,
                "company_id": self.env.company.id,
            })

            move_data = []

            for line in record.line_ids:
                lot = record._get_or_create_lot(line)

                move = stock_move_model.create({
                    "name": line.product_id.display_name,
                    "origin": record.name,
                    "product_id": line.product_id.id,
                    "product_uom_qty": line.quantity,
                    "product_uom": line.product_id.uom_id.id,
                    "location_id": source_location.id,
                    "location_dest_id": (
                        destination_location.id
                    ),
                    "picking_id": picking.id,
                    "company_id": self.env.company.id,
                })

                move_data.append((line, move, lot))

            picking.action_confirm()

            for line, move, lot in move_data:
                stock_move_line_model.create({
                    "move_id": move.id,
                    "picking_id": picking.id,
                    "company_id": self.env.company.id,
                    "product_id": line.product_id.id,
                    "product_uom_id": (
                        line.product_id.uom_id.id
                    ),
                    "quantity": line.quantity,
                    "picked": True,
                    "lot_id": lot.id,
                    "location_id": source_location.id,
                    "location_dest_id": (
                        destination_location.id
                    ),
                })

                line.write({
                    "lot_id": lot.id,
                    "stock_move_id": move.id,
                })

            validation_result = picking.with_context(
                cancel_backorder=True
            ).button_validate()

            if picking.state != "done":
                if isinstance(validation_result, dict):
                    raise UserError(
                        _(
                            "The stock transfer requires an "
                            "unexpected validation wizard."
                        )
                    )

                raise UserError(
                    _(
                        "The production stock transfer was "
                        "not completed."
                    )
                )

            qc_model = self.env[
                "vagirest.qc.record"
            ].sudo().with_company(self.env.company)

            qc_record = qc_model.search([
                ("production_record_id", "=", record.id),
            ], limit=1)

            if not qc_record:
                qc_record = qc_model.create({
                    "production_record_id": record.id,
                })

            record.write({
                "stock_picking_id": picking.id,
                "state": "submitted",
            })

            record.message_post(
                body=_(
                    "Production submitted to input-QC.<br/>"
                    "Stock Transfer: %s<br/>"
                    "QC Record: %s"
                )
                % (
                    picking.display_name,
                    qc_record.display_name,
                )
            )

        return True

    def action_return_to_draft(self):
        raise UserError(
            _(
                "A submitted production record cannot be "
                "returned to draft. Use a controlled stock "
                "correction process instead."
            )
        )

    def unlink(self):
        submitted_records = self.filtered(
            lambda record: record.state != "draft"
        )

        if submitted_records:
            raise UserError(
                _(
                    "Submitted production records cannot "
                    "be deleted."
                )
            )

        return super().unlink()


class VagirestProductionRecordLine(models.Model):
    _name = "vagirest.production.record.line"
    _description = "VAGIREST Production Record Line"
    _order = "id"

    record_id = fields.Many2one(
        "vagirest.production.record",
        string="Production Record",
        required=True,
        ondelete="cascade",
    )

    product_categ_id = fields.Many2one(
        "product.category",
        string="Product Category",
        readonly=True,
    )

    product_id = fields.Many2one(
        "product.product",
        string="Product",
        required=True,
        domain=[
            ("type", "=", "product"),
            ("tracking", "=", "lot"),
            ("active", "=", True),
        ],
    )

    quantity = fields.Float(
        string="Quantity",
        required=True,
        default=1.0,
    )

    generated_lot = fields.Char(
        string="Generated Lot",
        compute="_compute_generated_lot",
        store=True,
        readonly=True,
    )

    lot_id = fields.Many2one(
        "stock.lot",
        string="Lot",
        readonly=True,
        copy=False,
    )

    stock_move_id = fields.Many2one(
        "stock.move",
        string="Stock Move",
        readonly=True,
        copy=False,
    )

    @api.onchange("product_id")
    def _onchange_product_id(self):
        self.product_categ_id = (
            self.product_id.categ_id
            if self.product_id
            else False
        )

    @api.model_create_multi
    def create(self, vals_list):
        for vals in vals_list:
            product_id = vals.get("product_id")

            if (
                product_id
                and not vals.get("product_categ_id")
            ):
                product = self.env[
                    "product.product"
                ].browse(product_id)

                vals["product_categ_id"] = (
                    product.categ_id.id
                )

        return super().create(vals_list)

    @api.depends(
        "product_id",
        "record_id.raw_material_batch",
        "record_id.production_date",
    )
    def _compute_generated_lot(self):
        for line in self:
            if (
                line.product_id
                and line.record_id.raw_material_batch
                and line.record_id.production_date
            ):
                product_code = (
                    line.product_id.default_code
                    or str(line.product_id.id)
                )

                clean_batch = (
                    line.record_id.raw_material_batch
                    .strip()
                    .replace(" ", "-")
                    .replace("/", "-")
                    .replace("\\", "-")
                )

                date_text = (
                    line.record_id.production_date
                    .strftime("%Y%m%d")
                )

                line.generated_lot = (
                    f"{product_code}-"
                    f"{clean_batch}-"
                    f"{date_text}"
                )
            else:
                line.generated_lot = False
