<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_vagirest_rework_record_tree" model="ir.ui.view">
        <field name="name">vagirest.rework.record.tree</field>
        <field name="model">vagirest.rework.record</field>
        <field name="arch" type="xml">
            <tree string="Rework Records" create="false" delete="false" default_order="rework_date desc, id desc">
                <field name="name"/>
                <field name="rework_date"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="quantity"/>
                <field name="available_rework_qty"/>
                <field name="corrected_qty"/>
                <field name="rework_round"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_vagirest_rework_record_form" model="ir.ui.view">
        <field name="name">vagirest.rework.record.form</field>
        <field name="model">vagirest.rework.record</field>
        <field name="arch" type="xml">
            <form string="Rework Record" create="false" delete="false" duplicate="false">
                <header>
                    <button name="action_submit_to_qc"
                            string="ارسال مجدد به QC"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="این محصول اصلاح‌شده به input-QC برگردد؟"/>

                    <button name="action_cancel"
                            string="لغو"
                            type="object"
                            invisible="state != 'draft'"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted_to_qc,done"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="rework_date" readonly="state != 'draft'"/>
                            <field name="operator_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="lot_id" readonly="1"/>
                        </group>

                        <group>
                            <field name="quantity" readonly="1"/>
                            <field name="available_rework_qty" readonly="1"/>
                            <field name="corrected_qty" readonly="state != 'draft'"/>
                            <field name="rework_round" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <field name="correction_note"
                               placeholder="توضیح کوتاه اصلاح..."
                               readonly="state != 'draft'"/>
                    </group>

                    <group string="Traceability" groups="vagirest_production_record.group_vagirest_erp_manager,vagirest_production_record.group_vagirest_qc_manager">
                        <field name="production_record_id" readonly="1"/>
                        <field name="source_qc_record_id" readonly="1"/>
                        <field name="source_qc_line_id" readonly="1"/>
                        <field name="parent_rework_id" readonly="1"/>
                        <field name="return_picking_id" readonly="1"/>
                        <field name="rework_qc_record_id" readonly="1"/>
                    </group>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_vagirest_rework_record" model="ir.actions.act_window">
        <field name="name">Rework Records</field>
        <field name="res_model">vagirest.rework.record</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_vagirest_rework_record"
              name="Rework Records"
              parent="menu_vagirest_root"
              action="action_vagirest_rework_record"
              sequence="15"
              groups="vagirest_production_record.group_vagirest_production_operator,vagirest_production_record.group_vagirest_qc_manager"/>

    <record id="view_vagirest_rework_qc_record_tree" model="ir.ui.view">
        <field name="name">vagirest.rework.qc.record.tree</field>
        <field name="model">vagirest.rework.qc.record</field>
        <field name="arch" type="xml">
            <tree string="Rework QC Records" create="false" delete="false">
                <field name="name"/>
                <field name="rework_record_id"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="quantity"/>
                <field name="approved_qty"/>
                <field name="rework_qty"/>
                <field name="rejected_qty"/>
                <field name="inspector_id"/>
                <field name="decision_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_vagirest_rework_qc_record_form" model="ir.ui.view">
        <field name="name">vagirest.rework.qc.record.form</field>
        <field name="model">vagirest.rework.qc.record</field>
        <field name="arch" type="xml">
            <form string="Rework QC" create="false" delete="false" duplicate="false">
                <header>
                    <button name="action_submit_decision"
                            type="object"
                            string="ثبت تصمیم QC"
                            class="oe_highlight"
                            invisible="state != 'draft'"
                            confirm="تصمیم QC ثبت و انتقال‌ها انجام شود؟"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="rework_record_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="lot_id" readonly="1"/>
                            <field name="quantity" readonly="1"/>
                        </group>

                        <group>
                            <field name="inspector_id" readonly="1"/>
                            <field name="decision_date" readonly="1"/>
                        </group>
                    </group>

                    <separator string="QC Decision"/>

                    <group>
                        <field name="approved_qty" readonly="state == 'done'"/>
                        <field name="rework_qty" readonly="state == 'done'"/>
                        <field name="rejected_qty" readonly="state == 'done'"/>
                    </group>

                    <group>
                        <field name="note" placeholder="Optional QC note..." readonly="state == 'done'"/>
                    </group>

                    <group string="Created Stock Transfers" invisible="state != 'done'">
                        <field name="approved_picking_id" readonly="1" invisible="not approved_picking_id"/>
                        <field name="rework_picking_id" readonly="1" invisible="not rework_picking_id"/>
                        <field name="rejected_picking_id" readonly="1" invisible="not rejected_picking_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vagirest_rework_qc_record" model="ir.actions.act_window">
        <field name="name">Rework QC</field>
        <field name="res_model">vagirest.rework.qc.record</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_vagirest_rework_qc_record"
              name="Rework QC"
              parent="menu_vagirest_root"
              action="action_vagirest_rework_qc_record"
              sequence="25"
              groups="vagirest_production_record.group_vagirest_qc_manager"/>
</odoo>
