<odoo>
    <record id="view_vagirest_production_record_tree" model="ir.ui.view">
        <field name="name">vagirest.production.record.tree</field>
        <field name="model">vagirest.production.record</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="production_date"/>
                <field name="raw_material_batch"/>
                <field name="operator_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_vagirest_production_record_form" model="ir.ui.view">
        <field name="name">vagirest.production.record.form</field>
        <field name="model">vagirest.production.record</field>
        <field name="arch" type="xml">
            <form string="Production Record">
                <header>
                    <button name="action_submit_to_qc"
                            string="Send to QC"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="production_date"/>
                            <field name="raw_material_batch"/>
                        </group>
                        <group>
                            <field name="operator_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Produced Products">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_categ_id"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="generated_lot" readonly="1"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_vagirest_production_record" model="ir.actions.act_window">
        <field name="name">Production Records</field>
        <field name="res_model">vagirest.production.record</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_vagirest_root"
              name="VAGIREST Production"
              sequence="10"/>

    <menuitem id="menu_vagirest_production_record"
              name="Production Records"
              parent="menu_vagirest_root"
              action="action_vagirest_production_record"
              sequence="10"/>
</odoo>
