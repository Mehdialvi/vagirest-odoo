    <menuitem id="menu_vagirest_stock_picking_readonly"
              name="انتقالات"
              parent="menu_vagirest_inventory_readonly"
              action="action_vagirest_stock_picking_readonly"
              sequence="30"
              groups="vagirest_production_record.group_vagirest_inventory_viewer"/>

    <menuitem id="menu_vagirest_move_line_readonly"
              name="تاریخچه جابجایی‌ها"
              parent="menu_vagirest_inventory_readonly"
              action="action_vagirest_move_line_readonly"
              sequence="40"
              groups="vagirest_production_record.group_vagirest_inventory_viewer"/>
</odoo>
