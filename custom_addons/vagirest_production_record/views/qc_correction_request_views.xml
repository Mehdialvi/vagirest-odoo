<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_vagirest_qc_correction_request_tree"
            model="ir.ui.view">
        <field name="name">vagirest.qc.correction.request.tree</field>
        <field name="model">vagirest.qc.correction.request</field>
        <field name="arch" type="xml">
            <tree string="درخواست‌های اصلاح QC"
                  create="false"
                  delete="false">
                <field name="name"/>
                <field name="qc_record_id"/>
                <field name="requester_id"/>
                <field name="requested_at"/>
                <field name="action_type"/>
                <field name="state"/>
                <field name="reviewed_by_id"/>
            </tree>
        </field>
    </record>

    <record id="view_vagirest_qc_correction_request_form"
            model="ir.ui.view">
        <field name="name">vagirest.qc.correction.request.form</field>
        <field name="model">vagirest.qc.correction.request</field>
        <field name="arch" type="xml">
            <form string="درخواست اصلاح QC"
                  delete="false"
                  duplicate="false">

                <header>

                    <button name="action_submit_request"
                            type="object"
                            string="ارسال برای تأیید"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>

                    <button name="action_approve"
                            type="object"
                            string="تأیید اصلاح QC"
                            class="oe_highlight"
                            groups="vagirest_production_record.group_vagirest_erp_manager"
                            invisible="state != 'submitted'"
                            confirm="انتقال‌های QC در صورت وجود Reverse خواهند شد. ادامه می‌دهید؟"/>

                    <button name="action_reject"
                            type="object"
                            string="رد درخواست"
                            groups="vagirest_production_record.group_vagirest_erp_manager"
                            invisible="state != 'submitted'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,submitted,approved,applied,rejected"/>

                </header>

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="qc_record_id" readonly="1"/>
                            <field name="requester_id" readonly="1"/>
                            <field name="requested_at" readonly="1"/>
                        </group>

                        <group>
                            <field name="action_type"
                                   readonly="state != 'draft'"/>

                            <field name="reviewed_by_id"
                                   readonly="1"
                                   invisible="not reviewed_by_id"/>

                            <field name="reviewed_at"
                                   readonly="1"
                                   invisible="not reviewed_at"/>
                        </group>
                    </group>

                    <field name="reason"
                           readonly="state != 'draft'"
                           placeholder="علت دقیق اصلاح تصمیم QC را وارد کنید..."/>

                    <field name="review_note"
                           readonly="state not in ['submitted']"
                           placeholder="توضیح رد یا Override مدیریتی..."/>

                    <group string="Reverse Transfers">
                        <field name="approved_reversal_picking_id"
                               readonly="1"
                               invisible="not approved_reversal_picking_id"/>

                        <field name="rework_reversal_picking_id"
                               readonly="1"
                               invisible="not rework_reversal_picking_id"/>

                        <field name="rejected_reversal_picking_id"
                               readonly="1"
                               invisible="not rejected_reversal_picking_id"/>
                    </group>

                    <notebook>
                        <page string="Audit Trail"
                              groups="vagirest_production_record.group_vagirest_erp_manager">

                            <field name="change_summary"
                                   readonly="1"/>

                            <field name="before_snapshot"
                                   readonly="1"/>

                            <field name="after_snapshot"
                                   readonly="1"/>

                        </page>
                    </notebook>

                </sheet>

                <chatter/>

            </form>
        </field>
    </record>


    <record id="view_vagirest_qc_request_button"
            model="ir.ui.view">

        <field name="name">
            vagirest.qc.request.correction.button
        </field>

        <field name="model">vagirest.qc.record</field>

        <field name="inherit_id"
               ref="vagirest_production_record.view_vagirest_qc_record_form"/>

        <field name="arch" type="xml">

            <xpath expr="//button[@name='action_submit_decision']"
                   position="after">

                <button name="action_request_qc_correction"
                        type="object"
                        string="درخواست اصلاح QC"
                        class="btn-secondary"
                        invisible="state != 'done'"/>

            </xpath>

            <xpath expr="//sheet" position="inside">

                <div class="oe_button_box"
                     name="qc_correction_request_button_box">

                    <button name="action_open_qc_correction_requests"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-history"
                            invisible="qc_correction_request_count == 0">

                        <field name="qc_correction_request_count"
                               widget="statinfo"
                               string="اصلاح QC"/>

                    </button>

                </div>

                <field name="active_qc_correction_request_id"
                       invisible="1"/>

            </xpath>

        </field>
    </record>

</odoo>
