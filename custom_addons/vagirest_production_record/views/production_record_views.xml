<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="view_vagirest_production_record_tree" model="ir.ui.view">
        <field name="name">vagirest.production.record.tree</field>
        <field name="model">vagirest.production.record</field>
        <field name="arch" type="xml">
            <tree string="Production Records" default_order="production_date desc, id desc">
                <field name="name"/>
                <field name="production_date"/>
                <field name="raw_material_batch"/>
                <field name="operator_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_vagirest_production_record_form" model="ir.ui.view">
        <field name="name">vagirest.production.record.form</field>
        <field name="model">vagirest.production.record</field>
        <field name="arch" type="xml">
            <form string="Production Record">
                <header>
                    <button name="action_submit_to_qc" string="Submit Production" type="object" class="btn-primary" confirm="Submit this production record to input-QC?" invisible="state != 'draft'"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="raw_material_batch" placeholder="Enter raw material batch..." readonly="state != 'draft'"/>

                            <field name="production_date" readonly="state != 'draft'"/>
                        </group>

                        <group>
                            <field name="operator_id" readonly="1"/>

                            <field name="stock_picking_id" invisible="1" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Produced Products"/>

                    <field name="line_ids" readonly="state != 'draft'">
                        <tree editable="bottom" string="Produced Products">
                            <field name="product_id" options="{'no_create': True, 'no_create_edit': True}"/>

                            <field name="quantity"/>

                            <field name="product_categ_id" column_invisible="True"/>

                            <field name="generated_lot" column_invisible="True"/>

                            <field name="lot_id" column_invisible="True"/>

                            <field name="stock_move_id" column_invisible="True"/>
                        </tree>
                    </field>

                    <separator string="Optional Notes"/>

                    <field name="note" placeholder="Optional notes..." readonly="state != 'draft'"/>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_vagirest_production_record" model="ir.actions.act_window">
        <field name="name">Production Records</field>
        <field name="res_model">vagirest.production.record</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_vagirest_root" name="VAGIREST Production" sequence="10" groups="vagirest_production_record.group_vagirest_production_operator,vagirest_production_record.group_vagirest_qc_manager,vagirest_production_record.group_vagirest_inventory_viewer"/>

    <menuitem id="menu_vagirest_production_record" name="Production Records" parent="menu_vagirest_root" action="action_vagirest_production_record" sequence="10" groups="vagirest_production_record.group_vagirest_production_operator,vagirest_production_record.group_vagirest_qc_manager"/>

</odoo>
