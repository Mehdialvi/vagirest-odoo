<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="view_vagirest_qc_record_tree" model="ir.ui.view">
        <field name="name">vagirest.qc.record.tree</field>
        <field name="model">vagirest.qc.record</field>
        <field name="arch" type="xml">
            <tree string="QC Records" create="false" delete="false">
                <field name="name"/>
                <field name="production_record_id"/>
                <field name="production_date"/>
                <field name="operator_id"/>
                <field name="inspector_id"/>
                <field name="decision_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_vagirest_qc_record_form" model="ir.ui.view">
        <field name="name">vagirest.qc.record.form</field>
        <field name="model">vagirest.qc.record</field>
        <field name="arch" type="xml">
            <form string="QC Decision" create="false" delete="false" duplicate="false">
                <header>
                    <button name="action_submit_decision" type="object" string="Submit QC Decision" class="oe_highlight" invisible="state != 'draft'" confirm="Submit this QC decision and move the products?"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>

                <sheet>
                    <field name="active" invisible="1"/>

                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="production_record_id" readonly="1"/>
                            <field name="production_date" readonly="1"/>
                            <field name="operator_id" readonly="1"/>
                        </group>

                        <group>
                            <field name="inspector_id" readonly="state == 'done'"/>
                            <field name="decision_date" readonly="1"/>
                        </group>
                    </group>

                    <separator string="QC Quantities"/>

                    <field name="line_ids" readonly="state == 'done'">
                        <tree editable="bottom" create="false" delete="false">
                            <field name="production_line_id" column_invisible="True"/>
                            <field name="product_uom_id" column_invisible="True"/>
                            <field name="product_id" readonly="1"/>
                            <field name="lot_id" readonly="1"/>
                            <field name="produced_qty" readonly="1" sum="Total Produced"/>
                            <field name="approved_qty" sum="Total Approved"/>
                            <field name="rework_qty" sum="Total Rework"/>
                            <field name="rejected_qty" sum="Total Rejected"/>
                        </tree>
                    </field>

                    <group>
                        <field name="note" placeholder="Optional QC notes..." readonly="state == 'done'"/>
                    </group>

                    <group string="Created Stock Transfers" invisible="state != 'done'">
                        <field name="approved_picking_id" readonly="1" invisible="not approved_picking_id"/>
                        <field name="rework_picking_id" readonly="1" invisible="not rework_picking_id"/>
                        <field name="rejected_picking_id" readonly="1" invisible="not rejected_picking_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vagirest_qc_record" model="ir.actions.act_window">
        <field name="name">QC Records</field>
        <field name="res_model">vagirest.qc.record</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_vagirest_qc_record" name="QC Records" action="action_vagirest_qc_record" sequence="20" parent="menu_vagirest_root" groups="vagirest_production_record.group_vagirest_qc_manager"/>
</odoo>
