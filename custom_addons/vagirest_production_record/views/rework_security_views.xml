<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =====================================================
         REWORK RECORD
         Direct Cancel = ERP Manager emergency action only
         ===================================================== -->

    <record id="view_vagirest_rework_security_form"
            model="ir.ui.view">

        <field name="name">vagirest.rework.record.security.form</field>

        <field name="model">vagirest.rework.record</field>

        <field name="inherit_id"
               ref="vagirest_production_record.view_vagirest_rework_record_form"/>

        <field name="arch" type="xml">

            <xpath expr="//button[@name='action_cancel']"
                   position="attributes">

                <attribute name="invisible">1</attribute>

                <attribute name="groups">
                    vagirest_production_record.group_vagirest_erp_manager
                </attribute>

                <attribute name="confirm">
                    لغو مستقیم Rework فقط برای شرایط مدیریتی اضطراری است.
                    دلیل باید در Correction Note ثبت شده باشد.
                    ادامه می‌دهید؟
                </attribute>

            </xpath>

        </field>
    </record>


    <!-- =====================================================
         REWORK QC
         Cancelled becomes a real immutable audit state
         ===================================================== -->

    <record id="view_vagirest_rework_qc_security_form"
            model="ir.ui.view">

        <field name="name">vagirest.rework.qc.record.security.form</field>

        <field name="model">vagirest.rework.qc.record</field>

        <field name="inherit_id"
               ref="vagirest_production_record.view_vagirest_rework_qc_record_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='state']"
                   position="attributes">
                <attribute name="statusbar_visible">
                    draft,done,cancelled
                </attribute>
            </xpath>

            <xpath expr="//field[@name='approved_qty']"
                   position="attributes">
                <attribute name="readonly">
                    state != 'draft'
                </attribute>
            </xpath>

            <xpath expr="//field[@name='rework_qty']"
                   position="attributes">
                <attribute name="readonly">
                    state != 'draft'
                </attribute>
            </xpath>

            <xpath expr="//field[@name='rejected_qty']"
                   position="attributes">
                <attribute name="readonly">
                    state != 'draft'
                </attribute>
            </xpath>

            <xpath expr="//field[@name='note']"
                   position="attributes">
                <attribute name="readonly">
                    state != 'draft'
                </attribute>
            </xpath>

        </field>
    </record>

</odoo>
