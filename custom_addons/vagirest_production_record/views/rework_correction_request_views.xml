<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =====================================================
         REWORK CORRECTION REQUEST
         ===================================================== -->

    <record id="view_rework_correction_request_tree"
            model="ir.ui.view">
        <field name="name">vagirest.rework.correction.request.tree</field>
        <field name="model">vagirest.rework.correction.request</field>
        <field name="arch" type="xml">
            <tree create="false" delete="false">
                <field name="name"/>
                <field name="rework_record_id"/>
                <field name="requester_id"/>
                <field name="requested_at"/>
                <field name="state"/>
                <field name="reviewed_by_id"/>
            </tree>
        </field>
    </record>

    <record id="view_rework_correction_request_form"
            model="ir.ui.view">
        <field name="name">vagirest.rework.correction.request.form</field>
        <field name="model">vagirest.rework.correction.request</field>
        <field name="arch" type="xml">
            <form delete="false" duplicate="false">
                <header>

                    <button name="action_submit_request"
                            type="object"
                            string="ارسال درخواست"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>

                    <button name="action_approve"
                            type="object"
                            string="تأیید"
                            class="oe_highlight"
                            groups="vagirest_production_record.group_vagirest_qc_manager,vagirest_production_record.group_vagirest_erp_manager"
                            invisible="state != 'submitted'"/>

                    <button name="action_reject"
                            type="object"
                            string="رد"
                            groups="vagirest_production_record.group_vagirest_qc_manager,vagirest_production_record.group_vagirest_erp_manager"
                            invisible="state != 'submitted'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,submitted,approved,applied,rejected"/>

                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="rework_record_id" readonly="1"/>
                            <field name="requester_id" readonly="1"/>
                            <field name="requested_at" readonly="1"/>
                        </group>

                        <group>
                            <field name="reviewed_by_id" readonly="1"/>
                            <field name="reviewed_at" readonly="1"/>
                            <field name="reversal_picking_id" readonly="1"/>
                            <field name="old_rework_qc_record_id" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <field name="reason"
                               readonly="state != 'draft'"/>
                        <field name="review_note"/>
                    </group>

                    <notebook groups="vagirest_production_record.group_vagirest_erp_manager">
                        <page string="Audit Trail">
                            <field name="before_snapshot"
                                   readonly="1"/>
                            <field name="after_snapshot"
                                   readonly="1"/>
                            <field name="change_summary"
                                   readonly="1"/>
                            <field name="applied_at"
                                   readonly="1"/>
                        </page>
                    </notebook>

                </sheet>

                <chatter/>
            </form>
        </field>
    </record>


    <!-- =====================================================
         REWORK QC CORRECTION REQUEST
         ===================================================== -->

    <record id="view_rework_qc_correction_request_tree"
            model="ir.ui.view">
        <field name="name">vagirest.rework.qc.correction.request.tree</field>
        <field name="model">vagirest.rework.qc.correction.request</field>
        <field name="arch" type="xml">
            <tree create="false" delete="false">
                <field name="name"/>
                <field name="rework_qc_record_id"/>
                <field name="requester_id"/>
                <field name="requested_at"/>
                <field name="state"/>
                <field name="reviewed_by_id"/>
            </tree>
        </field>
    </record>

    <record id="view_rework_qc_correction_request_form"
            model="ir.ui.view">
        <field name="name">vagirest.rework.qc.correction.request.form</field>
        <field name="model">vagirest.rework.qc.correction.request</field>
        <field name="arch" type="xml">
            <form delete="false" duplicate="false">
                <header>

                    <button name="action_submit_request"
                            type="object"
                            string="ارسال درخواست"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>

                    <button name="action_approve"
                            type="object"
                            string="تأیید ERP"
                            class="oe_highlight"
                            groups="vagirest_production_record.group_vagirest_erp_manager"
                            invisible="state != 'submitted'"/>

                    <button name="action_reject"
                            type="object"
                            string="رد"
                            groups="vagirest_production_record.group_vagirest_erp_manager"
                            invisible="state != 'submitted'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,submitted,approved,applied,rejected"/>

                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="rework_qc_record_id" readonly="1"/>
                            <field name="requester_id" readonly="1"/>
                            <field name="requested_at" readonly="1"/>
                        </group>

                        <group>
                            <field name="reviewed_by_id" readonly="1"/>
                            <field name="reviewed_at" readonly="1"/>
                            <field name="cancelled_child_rework_id"
                                   readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <field name="reason"
                               readonly="state != 'draft'"/>
                        <field name="review_note"/>
                    </group>

                    <group string="Reversal Transfers"
                           groups="vagirest_production_record.group_vagirest_erp_manager">
                        <field name="approved_reversal_picking_id"
                               readonly="1"/>
                        <field name="rework_reversal_picking_id"
                               readonly="1"/>
                        <field name="rejected_reversal_picking_id"
                               readonly="1"/>
                    </group>

                    <notebook groups="vagirest_production_record.group_vagirest_erp_manager">
                        <page string="Audit Trail">
                            <field name="before_snapshot"
                                   readonly="1"/>
                            <field name="after_snapshot"
                                   readonly="1"/>
                            <field name="change_summary"
                                   readonly="1"/>
                            <field name="applied_at"
                                   readonly="1"/>
                        </page>
                    </notebook>

                </sheet>

                <chatter/>
            </form>
        </field>
    </record>


    <!-- =====================================================
         ADD REQUEST BUTTONS TO REWORK
         ===================================================== -->

    <record id="view_rework_record_correction_request_form"
            model="ir.ui.view">

        <field name="name">vagirest.rework.record.correction.request.form</field>
        <field name="model">vagirest.rework.record</field>
        <field name="inherit_id"
               ref="vagirest_production_record.view_vagirest_rework_record_form"/>

        <field name="arch" type="xml">

            <xpath expr="//header/button[@name='action_submit_to_qc']"
                   position="after">

                <button name="action_request_rework_correction"
                        type="object"
                        string="درخواست اصلاح Rework"
                        invisible="state != 'submitted_to_qc'"/>

            </xpath>

            <xpath expr="//sheet"
                   position="inside">

                <field name="active_rework_correction_request_id"
                       invisible="1"/>

                <button name="action_open_rework_correction_requests"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-history">
                    <field name="rework_correction_request_count"
                           widget="statinfo"
                           string="Correction Requests"/>
                </button>

            </xpath>

        </field>
    </record>


    <!-- =====================================================
         ADD REQUEST BUTTONS TO REWORK QC
         ===================================================== -->

    <record id="view_rework_qc_record_correction_request_form"
            model="ir.ui.view">

        <field name="name">vagirest.rework.qc.record.correction.request.form</field>
        <field name="model">vagirest.rework.qc.record</field>
        <field name="inherit_id"
               ref="vagirest_production_record.view_vagirest_rework_qc_record_form"/>

        <field name="arch" type="xml">

            <xpath expr="//header/button[@name='action_submit_decision']"
                   position="after">

                <button name="action_request_rework_qc_correction"
                        type="object"
                        string="درخواست اصلاح Rework QC"
                        groups="vagirest_production_record.group_vagirest_qc_manager"
                        invisible="state != 'done'"/>

            </xpath>

            <xpath expr="//sheet"
                   position="inside">

                <field name="active_rework_qc_correction_request_id"
                       invisible="1"/>

                <button name="action_open_rework_qc_correction_requests"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-history">
                    <field name="rework_qc_correction_request_count"
                           widget="statinfo"
                           string="Correction Requests"/>
                </button>

            </xpath>

        </field>
    </record>

</odoo>
