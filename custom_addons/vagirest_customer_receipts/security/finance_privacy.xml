<odoo>
<record id="group_customer_finance_only" model="res.groups"><field name="name">VAGIREST: Customer finance only</field></record>
<record id="privacy_account_journal" model="ir.rule"><field name="name">VAGIREST block raw account.journal for restricted users</field><field name="model_id" ref="account.model_account_journal"/><field name="domain_force">[('id', '=', 0)] if user.has_group('vagirest_customer_receipts.group_customer_finance_only') else [(1, '=', 1)]</field></record>
<record id="privacy_account_move" model="ir.rule"><field name="name">VAGIREST block raw account.move for restricted users</field><field name="model_id" ref="account.model_account_move"/><field name="domain_force">[('id', '=', 0)] if user.has_group('vagirest_customer_receipts.group_customer_finance_only') else [(1, '=', 1)]</field></record>
<record id="privacy_account_move_line" model="ir.rule"><field name="name">VAGIREST block raw account.move.line for restricted users</field><field name="model_id" ref="account.model_account_move_line"/><field name="domain_force">[('id', '=', 0)] if user.has_group('vagirest_customer_receipts.group_customer_finance_only') else [(1, '=', 1)]</field></record>
<record id="privacy_account_payment" model="ir.rule"><field name="name">VAGIREST block raw account.payment for restricted users</field><field name="model_id" ref="account.model_account_payment"/><field name="domain_force">[('id', '=', 0)] if user.has_group('vagirest_customer_receipts.group_customer_finance_only') else [(1, '=', 1)]</field></record>
<record id="privacy_account_bank_statement" model="ir.rule"><field name="name">VAGIREST block raw account.bank.statement for restricted users</field><field name="model_id" ref="account.model_account_bank_statement"/><field name="domain_force">[('id', '=', 0)] if user.has_group('vagirest_customer_receipts.group_customer_finance_only') else [(1, '=', 1)]</field></record>
<record id="privacy_account_bank_statement_line" model="ir.rule"><field name="name">VAGIREST block raw account.bank.statement.line for restricted users</field><field name="model_id" ref="account.model_account_bank_statement_line"/><field name="domain_force">[('id', '=', 0)] if user.has_group('vagirest_customer_receipts.group_customer_finance_only') else [(1, '=', 1)]</field></record>
<record id="company_vagirest_customer_balance" model="ir.rule"><field name="name">Balance allowed companies</field><field name="model_id" ref="model_vagirest_customer_balance"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="company_vagirest_customer_balance_line" model="ir.rule"><field name="name">Balance allowed companies</field><field name="model_id" ref="model_vagirest_customer_balance_line"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="balance_personal_rule" model="ir.rule"><field name="name">Only assigned customer balances</field><field name="model_id" ref="model_vagirest_customer_balance"/><field name="groups" eval="[(4, ref('vagirest_native_dashboard.group_personal_dashboard'))]"/><field name="domain_force">[('followup_user_id', '=', user.id)]</field></record>
<record id="balance_manager_rule" model="ir.rule"><field name="name">Manager customer balances</field><field name="model_id" ref="model_vagirest_customer_balance"/><field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
</odoo>