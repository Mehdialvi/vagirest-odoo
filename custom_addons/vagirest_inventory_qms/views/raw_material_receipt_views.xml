<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="view_vagirest_raw_material_receipt_tree" model="ir.ui.view">
        <field name="name">vagirest.raw.material.receipt.tree</field>
        <field name="model">vagirest.raw.material.receipt</field>
        <field name="arch" type="xml">
            <tree string="رسید مواد اولیه و بسته‌بندی">
                <field name="name"/>
                <field name="receipt_date"/>
                <field name="supplier_id"/>
                <field name="warehouse_keeper_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_vagirest_raw_material_receipt_form" model="ir.ui.view">
        <field name="name">vagirest.raw.material.receipt.form</field>
        <field name="model">vagirest.raw.material.receipt</field>
        <field name="arch" type="xml">

            <form string="رسید مواد اولیه و بسته‌بندی">

                <header>

                    <button name="action_mark_received" type="object" string="ثبت دریافت و ورود به QC" class="oe_highlight" invisible="state != 'draft'" groups="vagirest_inventory_qms.group_vagirest_f02_user" confirm="کالاها به صورت واقعی وارد input-QC خواهند شد. ادامه می‌دهید؟"/>

                    <button name="action_finalize_qc" type="object" string="ثبت تصمیم QC" class="oe_highlight" invisible="state != 'received'" groups="vagirest_production_record.group_vagirest_qc_manager" confirm="نتیجه QC باعث انتقال واقعی موجودی خواهد شد. ادامه می‌دهید؟"/>

                    <button name="action_reopen_qc" type="object" string="بازگشایی تصمیم QC" class="btn-secondary" invisible="state not in ['approved','rejected','mixed']" groups="vagirest_production_record.group_vagirest_qc_manager" confirm="حرکت‌های QC به صورت واقعی Reverse خواهند شد. ادامه می‌دهید؟"/><button name="action_reverse_receipt_to_draft" type="object" string="Reverse دریافت و بازگشت به Draft" class="btn-secondary" invisible="state != 'received'" groups="vagirest_inventory_qms.group_vagirest_f02_user" confirm="رسید ورودی انبار Reverse خواهد شد. ادامه می‌دهید؟"/><field name="state" widget="statusbar" statusbar_visible="draft,received,approved,mixed,rejected,cancelled"/>

                </header>

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>

                        <group string="اطلاعات رسید">
                            <field name="form_code"/>
                            <field name="receipt_date" readonly="state != 'draft'"/>
                            <field name="warehouse_keeper_id"/>
                            <field name="supplier_id" readonly="state != 'draft'"/>
                        </group>

                        <group string="اطلاعات تحویل">
                            <field name="invoice_reference" readonly="state != 'draft'"/>
                            <field name="delivered_by" readonly="state != 'draft'"/>
                            <field name="delivery_datetime" readonly="state != 'draft'"/>
                            <field name="control_report_no" readonly="state not in ['draft','received']"/>
                        </group>

                    </group>

                    <notebook>

                        <page string="اقلام">

                            <field name="line_ids" readonly="state not in ['draft','received']">
                                <tree editable="bottom" create="state == 'draft'" delete="state == 'draft'">
                                    <field name="product_id" readonly="parent.state != 'draft'"/>

                                    <field name="product_code"/>
                                    <field name="inventory_class"/>

                                    <field name="quantity" readonly="parent.state != 'draft'"/>

                                    <field name="uom_id"/>

                                    <field name="lot_name" readonly="parent.state != 'draft'"/>

                                    <field name="lot_id"/>

                                    <field name="inspection_result" readonly="parent.state != 'received'"/>

                                    <field name="note" readonly="parent.state not in ['draft','received']"/>
                                </tree>
                            </field>

                        </page>

                        <page string="کنترل کیفیت">

                            <group>
                                <group>
                                    <field name="qc_inspector_id"/>
                                    <field name="qc_decision_date"/>
                                    <field name="control_report_no"/>
                                </group>

                                <group>
                                    <field name="note"/>
                                </group>
                            </group>

                        </page>

                        <page string="ردیابی انبار">

                            <group>
                                <field name="incoming_picking_id"/>
                                <field name="raw_approved_picking_id"/>
                                <field name="packaging_approved_picking_id"/>
                                <field name="rejected_picking_id"/>
                            </group>

                        </page>

                    <page string="اصلاح و سوابق"><group><group><field name="correction_reason" readonly="state not in ['received','approved','rejected','mixed']"/><field name="correction_count" readonly="1"/><field name="last_corrected_by_id" readonly="1"/><field name="last_correction_date" readonly="1"/><field name="last_correction_reason" readonly="1"/></group><group><field name="incoming_reversal_picking_id" readonly="1"/><field name="raw_approved_reversal_picking_id" readonly="1"/><field name="packaging_approved_reversal_picking_id" readonly="1"/><field name="rejected_reversal_picking_id" readonly="1"/></group></group></page></notebook>

                </sheet>

                <chatter/>

            </form>

        </field>
    </record>


    <record id="action_vagirest_raw_material_receipt" model="ir.actions.act_window">
        <field name="name">رسید مواد اولیه و بسته‌بندی</field>
        <field name="res_model">vagirest.raw.material.receipt</field>
        <field name="view_mode">tree,form</field>
    </record>


    <menuitem id="menu_vagirest_inventory_qms_root" name="انبار و QMS واژیرست" sequence="40" groups="vagirest_inventory_qms.group_vagirest_f02_user"/>

    <menuitem id="menu_vagirest_raw_material_receipt" name="رسید مواد اولیه و بسته‌بندی F02" parent="menu_vagirest_inventory_qms_root" action="action_vagirest_raw_material_receipt" sequence="10" groups="vagirest_inventory_qms.group_vagirest_f02_user"/>

</odoo>
